"""zotero-add: add items/attachments to Zotero safely, via zotero-cli's JS bridge.

Guards against the failure modes seen in practice:
  - duplicates (checked by title, URL, DOI and citation key before creating);
  - the Linter plugin lower-casing proper nouns in new titles (title is re-applied);
  - Zotero Attanger moving new files out of group-library storage, which leaves
    broken attachments (files are moved back; see `repair`);
  - bridge calls that "time out" but still complete (results are polled, not retried).

Run `zotero-add --help` or `zotero-add <command> --help`.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time

DEFAULT_TAGS = ["added-by-claude"]


# ---------------------------------------------------------------- bridge
def js(code, wait=60):
    """Run JS in Zotero; return the value the code returns (JSON-decoded if possible)."""
    try:
        p = subprocess.run(["zotero-cli", "--json", "js", "--wait", str(wait), code],
                           capture_output=True, text=True, timeout=wait + 30)
    except subprocess.TimeoutExpired:
        return {"_timeout": True}
    out = p.stdout.strip()
    try:
        val = json.loads(out)
    except json.JSONDecodeError:
        die(f"unexpected zotero-cli output: {out[:300]} {p.stderr[:300]}")
    if isinstance(val, dict) and val.get("ok") is False:
        if "timed out" in str(val.get("error", "")):
            return {"_timeout": True}
        die(f"Zotero error: {val.get('error')}")
    if isinstance(val, str):
        try:
            return json.loads(val)
        except json.JSONDecodeError:
            return val
    return val


def die(msg, code=2):
    print(f"zotero-add: {msg}", file=sys.stderr)
    sys.exit(code)


def J(x):
    return json.dumps(x)


def lib_js(library):
    """JS expression resolving --library to a libraryID."""
    return f"""(()=>{{const L={J(str(library))};
      if(L==='user') return Zotero.Libraries.userLibraryID;
      if(/^\\d+$/.test(L)){{const n=parseInt(L);
        if(Zotero.Groups.getLibraryIDFromGroupID(n)) return Zotero.Groups.getLibraryIDFromGroupID(n);
        if(Zotero.Libraries.exists(n)) return n;}}
      const g=Zotero.Groups.getAll().find(g=>g.name.toLowerCase()===L.toLowerCase());
      if(g) return g.libraryID;
      throw new Error('unknown library '+L);}})()"""


# ---------------------------------------------------------------- dup check
def find_dups(library, title=None, url=None, doi=None, key=None):
    code = f"""
const lib={lib_js(library)};
const norm=s=>(s||'').toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g,' ').trim();
const T=norm({J(title or '')}), U=({J(url or '')}).replace(/^https?:\\/\\/(www\\.)?/,'').replace(/\\/$/,''),
      D=({J(doi or '')}).toLowerCase(), K={J(key or '')};
const hits=new Map();
async function run(conds){{const s=new Zotero.Search();s.libraryID=lib;s.addCondition('deleted','false');
  for(const c of conds) s.addCondition(...c); for(const id of await s.search()) hits.set(id,1);}}
if(T){{const words=T.split(' ').filter(w=>w.length>3).sort((a,b)=>b.length-a.length).slice(0,2);
  if(words.length) await run(words.map(w=>['title','contains',w]));}}
if(U) await run([['url','contains',U]]);
if(D) await run([['DOI','is',D]]);
if(K) await run([['citationKey','is',K]]);
const out=[];
for(const it of await Zotero.Items.getAsync([...hits.keys()])){{
  if(!it.isRegularItem()) continue;
  const t=norm(it.getField('title')); const why=[];
  const [sh,lo]=t.length<T.length?[t,T]:[T,t];
  if(T && t && (t===T || (sh.length>20 && sh.length>=0.7*lo.length && lo.includes(sh)))) why.push('title');
  const u=(it.getField('url')||'').replace(/^https?:\\/\\/(www\\.)?/,'').replace(/\\/$/,'');
  if(U && u && u===U) why.push('url');
  if(D && (it.getField('DOI')||'').toLowerCase()===D) why.push('doi');
  if(K && it.getField('citationKey')===K) why.push('citationKey');
  if(why.length) out.push({{key:it.key,citationKey:it.getField('citationKey'),title:it.getField('title'),
    type:it.itemType,date:it.getField('date'),match:why}});
}}
return JSON.stringify(out);"""
    return js(code, 60)


# ---------------------------------------------------------------- attachments
def attachments(item_key, library):
    code = f"""
const lib={lib_js(library)};const p=Zotero.Items.getByLibraryAndKey(lib,{J(item_key)});
if(!p) throw new Error('no item {item_key}');
const out=[];for(const id of p.getAttachments()){{const a=Zotero.Items.get(id);
  let exists=null;try{{exists=await a.fileExists();}}catch(e){{exists=false;}}
  let expected=null;try{{expected=a.getFilePath();}}catch(e){{expected=a.attachmentPath||null;}}
  out.push({{key:a.key,linkMode:a.attachmentLinkMode,contentType:a.attachmentContentType,
    title:a.getField('title'),exists,expected}});}}
return JSON.stringify(out);"""
    return js(code, 60)


def attanger_dest():
    d = js("return Zotero.Prefs.get('extensions.zotero.zoteroattanger.destDir',true)||''", 30)
    return d if isinstance(d, str) else ""


def _norm_name(n):
    return re.sub(r"[^a-z0-9]+", "", n.lower())


def restore_file(expected):
    """Find a file Attanger moved and put it back at `expected`. Returns new location or None."""
    dest = attanger_dest()
    if not dest or not os.path.isdir(dest):
        return None
    want = os.path.basename(expected)
    wn, ext = _norm_name(os.path.splitext(want)[0]), os.path.splitext(want)[1].lower()
    storage = os.path.join(dest, "storage")
    best = None
    for root, dirs, files in os.walk(dest):
        if root.startswith(storage):
            dirs[:] = []
            continue
        for f in files:
            if os.path.splitext(f)[1].lower() != ext:
                continue
            fn = _norm_name(os.path.splitext(f)[0])
            # Attanger may truncate long names; accept prefix matches of reasonable length
            if fn == wn or (len(fn) >= 30 and (wn.startswith(fn) or fn.startswith(wn))):
                path = os.path.join(root, f)
                if best is None or os.path.getmtime(path) > os.path.getmtime(best):
                    best = path
    if not best:
        return None
    os.makedirs(os.path.dirname(expected), exist_ok=True)
    shutil.move(best, expected)
    # remove now-empty folders Attanger created
    d = os.path.dirname(best)
    while d.startswith(dest) and d != dest and not os.listdir(d):
        os.rmdir(d)
        d = os.path.dirname(d)
    return expected


def verify_and_repair(item_key, library, settle=8):
    time.sleep(settle)  # give Attanger time to act
    bad = []
    for a in attachments(item_key, library):
        if a["linkMode"] in (0, 1) and not a["exists"]:
            got = restore_file(a["expected"])
            print(f"  attachment {a['key']}: file missing; "
                  + (f"restored to {got}" if got else "COULD NOT FIND moved file"))
            if not got:
                bad.append(a["key"])
        else:
            print(f"  attachment {a['key']} ({a['contentType']}): ok")
    return bad


def attach_file(item_key, library, path, wait=120):
    path = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(path):
        die(f"no such file: {path}")
    code = f"""
const lib={lib_js(library)};const p=Zotero.Items.getByLibraryAndKey(lib,{J(item_key)});
const a=await Zotero.Attachments.importFromFile({{file:{J(path)},parentItemID:p.id}});
return a.key;"""
    r = js(code, wait)
    print(f"  attached file {os.path.basename(path)}"
          + (" (bridge timed out; will verify)" if isinstance(r, dict) else f" as {r}"))


def attach_snapshot(item_key, library, url=None, wait=240):
    code = f"""
const lib={lib_js(library)};const p=Zotero.Items.getByLibraryAndKey(lib,{J(item_key)});
const url={J(url or '')}||p.getField('url'); if(!url) throw new Error('item has no URL');
for(const id of p.getAttachments()) if(Zotero.Items.get(id).attachmentContentType==='text/html') return 'exists';
const a=await Zotero.Attachments.importFromURL({{libraryID:lib,url,parentItemID:p.id,contentType:'text/html',title:'Snapshot'}});
return a.key;"""
    r = js(code, wait)
    if r == "exists":
        print("  snapshot: item already has an HTML attachment")
        return
    if isinstance(r, dict):  # timed out on the bridge; Zotero may still finish
        for _ in range(24):
            time.sleep(5)
            if any(a["contentType"] == "text/html" and a["exists"] for a in attachments(item_key, library)):
                break
    html = [a for a in attachments(item_key, library) if a["contentType"] == "text/html" and a["exists"]]
    if not html:
        print("  snapshot: FAILED (site may block Zotero; fetch it yourself and use `attach --file x.html`)")
        return
    f = html[0]["expected"]
    with open(f, errors="ignore") as fh:
        head = fh.read(200000)
    title = re.findall(r"<title>(.*?)</title>", head, re.S)
    blocked = re.search(r"Just a moment|Access denied|403 Forbidden|captcha|Web Page Blocked", head, re.I)
    print(f"  snapshot {html[0]['key']}: {os.path.getsize(f)} bytes, title={title[0].strip()[:70] if title else '?'!r}"
          + ("  WARNING: looks like a block page" if blocked else ""))


# ---------------------------------------------------------------- commands
def parse_creators(persons, orgs, order):
    out = []
    for kind, val in order:
        role = "author"
        if "@" in val:
            val, role = val.rsplit("@", 1)
        if kind == "person":
            if "," in val:
                last, first = [s.strip() for s in val.split(",", 1)]
            else:
                parts = val.split()
                last, first = parts[-1], " ".join(parts[:-1])
            out.append({"lastName": last, "firstName": first, "creatorType": role})
        else:
            out.append({"name": val.strip(), "creatorType": role, "fieldMode": 1})
    return out


class Ordered(argparse.Action):
    def __call__(self, parser, ns, values, option_string=None):
        lst = getattr(ns, "creator_order", None) or []
        lst.append((self.dest, values))
        ns.creator_order = lst


def cmd_item(a):
    if not a.force:
        d = find_dups(a.library, a.title, a.url, a.field_dict.get("DOI"), a.key)
        if d:
            print("Possible duplicates found; not adding (use --force to add anyway):")
            for x in d:
                print(f"  {x['key']} [{x['citationKey']}] {x['type']} {x['date']} — {x['title']}  (match: {','.join(x['match'])})")
            sys.exit(1)
    fields = dict(a.field_dict)
    fields["title"] = a.title
    if a.date: fields["date"] = a.date
    if a.url: fields["url"] = a.url
    creators = parse_creators(None, None, getattr(a, "creator_order", None) or [])
    tags = (a.tag or []) + ([] if a.no_default_tags else DEFAULT_TAGS)
    code = f"""
const lib={lib_js(a.library)};
const it=new Zotero.Item({J(a.type)});it.libraryID=lib;
for(const [k,v] of Object.entries({J(fields)})) it.setField(k,v);
it.setCreators({J(creators)});
if({J(a.key or '')}) it.setField('citationKey',{J(a.key or '')});
for(const t of {J(tags)}) it.addTag(t);
for(const c of {J(a.collection or [])}){{const col=Zotero.Collections.getByLibraryAndKey(lib,c);
  if(!col) throw new Error('no collection '+c); it.addToCollection(col.id);}}
await it.saveTx();return it.key;"""
    key = js(code, 60)
    if not isinstance(key, str):
        die("item creation did not confirm; check Zotero before retrying (avoid duplicates)")
    print(f"created {key}" + (f" [{a.key}]" if a.key else ""))
    time.sleep(3)  # let the Linter plugin run, then restore the intended title
    t = js(f"""const lib={lib_js(a.library)};const it=Zotero.Items.getByLibraryAndKey(lib,{J(key)});
if(it.getField('title')!=={J(a.title)}){{it.setField('title',{J(a.title)});await it.saveTx();return 'fixed';}}
return 'ok';""", 60)
    print(f"  title: {t}")
    for f in a.file or []:
        attach_file(key, a.library, f)
    if a.snapshot:
        attach_snapshot(key, a.library)
    if a.file or a.snapshot:
        if verify_and_repair(key, a.library):
            sys.exit(3)
    print(json.dumps({"key": key, "citationKey": a.key}))


def cmd_attach(a):
    if not (a.file or a.snapshot):
        die("give --file and/or --snapshot")
    for f in a.file or []:
        attach_file(a.item, a.library, f)
    if a.snapshot:
        attach_snapshot(a.item, a.library, a.url)
    if verify_and_repair(a.item, a.library):
        sys.exit(3)


def cmd_dups(a):
    d = find_dups(a.library, a.title, a.url, a.doi, a.key)
    for x in d:
        print(f"{x['key']} [{x['citationKey']}] {x['type']} {x['date']} — {x['title']}  (match: {','.join(x['match'])})")
    sys.exit(1 if d else 0)


def cmd_check(a):
    for x in attachments(a.item, a.library):
        print(f"{x['key']} linkMode={x['linkMode']} {x['contentType']} exists={x['exists']}  {x['expected']}")


def cmd_audit(a):
    """Read-only health check: missing stored/linked files + disk orphans. Exit 1 if issues."""
    code = f"""
const lib={lib_js(a.library)};
const s=new Zotero.Search();s.libraryID=lib;s.addCondition('itemType','is','attachment');
{"s.addCondition('dateAdded','isAfter'," + J(a.since) + ");" if a.since else ""}
const storedMissing=[],linkedMissing=[];
for(const it of await Zotero.Items.getAsync(await s.search())){{
  const m=it.attachmentLinkMode;
  let ex=null;try{{ex=await it.fileExists();}}catch(e){{ex=false;}}
  if(ex) continue;
  const row={{key:it.key,parent:it.parentItem?it.parentItem.key:'',
    title:(it.getField('title')||'').slice(0,60)}};
  // mode 2 = linked file (a missing one is breakage); mode 3 = bare URL
  // link (no file involved) — never reported as missing
  if(m===2){{row['path']=it.attachmentPath||null;linkedMissing.push(row);}}
  else if(m<2){{let p=null;try{{p=it.getFilePath();}}catch(e){{}}
    row['expected']=p;storedMissing.push(row);}}
}}
// linked paths across ALL libraries, so the orphan scan doesn't flag
// files that belong to a different library than the one audited
const linkedPaths=[];
for(const lb of Zotero.Libraries.getAll()){{
  const q=new Zotero.Search();q.libraryID=lb.id;q.addCondition('itemType','is','attachment');
  for(const it of await Zotero.Items.getAsync(await q.search())){{
    if(it.attachmentLinkMode===2&&!it.deleted){{
      let p=null;try{{p=it.getFilePath();}}catch(e){{p=it.attachmentPath||null;}}
      if(p) linkedPaths.push(p);
    }}
  }}
}}
return JSON.stringify({{storedMissing,linkedMissing,linkedPaths}});"""
    r = js(code, 300)
    if isinstance(r, dict) and "_timeout" in r:
        die("bridge timed out listing attachments; try --since YYYY-MM-DD")
    if not isinstance(r, dict):
        die(f"unexpected audit result: {str(r)[:200]}")
    issues = 0
    for m in r["storedMissing"]:
        print(f"stored-missing {m['key']} [{m['parent']}] {m['title']}  expected: {m['expected']}")
        issues += 1
    for m in r["linkedMissing"]:
        print(f"linked-missing {m['key']} [{m['parent']}] {m['title']}  path: {m['path']}")
        issues += 1
    # disk orphans: pdf/epub under the Attanger destDir (outside storage/) with no linked record
    dest = attanger_dest()
    if dest and os.path.isdir(dest):
        known = {os.path.normpath(p[len("attachments:"):] if p.startswith("attachments:") else p)
                 for p in r["linkedPaths"] if p}
        storage = os.path.join(dest, "storage")
        n = 0
        for root, dirs, files in os.walk(dest):
            if root.startswith(storage):
                dirs[:] = []
                continue
            for f in files:
                if not f.lower().endswith((".pdf", ".epub")):
                    continue
                p = os.path.normpath(os.path.join(root, f))
                if p not in known:
                    print(f"disk-orphan  {p}")
                    n += 1
        issues += n
    else:
        print("(orphan scan skipped: Attanger destDir unset or missing)")
    if not issues:
        print("audit clean: all attachment files exist, no disk orphans")
    sys.exit(1 if issues else 0)


def cmd_fetch_pdf(a):
    """DOI -> PDF cascade: OpenAlex, Unpaywall, arXiv, Sci-Hub mirrors. Attaches first hit."""
    a.sources = [s.strip().lower() for s in a.sources.split(",") if s.strip()]
    a.mirrors = [m.strip() for m in a.mirrors.split(",") if m.strip()]
    doi = (a.doi or "").strip()
    if not doi:
        code = f"""const lib={lib_js(a.library)};const p=Zotero.Items.getByLibraryAndKey(lib,{J(a.item)});
if(!p) throw new Error('no item '+{J(a.item)});return p.getField('DOI')||'';"""
        doi = (js(code, 60) or "").strip()
    if not doi:
        die(f"no DOI given and item {a.item} has none")
    doi = re.sub(r"^https?://(dx\.)?doi\.org/", "", doi, flags=re.I)
    if not a.force:
        code = f"""const lib={lib_js(a.library)};const p=Zotero.Items.getByLibraryAndKey(lib,{J(a.item)});
if(!p) throw new Error('no item '+{J(a.item)});
for(const id of p.getAttachments()){{const x=Zotero.Items.get(id);
  if(x.attachmentContentType==='application/pdf') return x.key;}} return '';"""
        have = js(code, 60)
        if have:
            print(f"item already has a PDF attachment ({have}); use --force to add another")
            return
    pdf_url, via = None, None
    if "openalex" in a.sources:
        pdf_url, via = openalex_pdf(doi)
    if not pdf_url and "unpaywall" in a.sources:
        pdf_url, via = unpaywall_pdf(doi, a.email)
    if not pdf_url and "arxiv" in a.sources and doi.lower().startswith("10.48550/arxiv."):
        pdf_url, via = arxiv_pdf(doi)
    if not pdf_url and "scihub" in a.sources:
        pdf_url, via = scihub_pdf(doi, a.mirrors)
    if not pdf_url:
        die(f"no PDF found for {doi} (tried: {','.join(a.sources)})")
    print(f"  found via {via}: {pdf_url[:100]}")
    code = f"""
const lib={lib_js(a.library)};const p=Zotero.Items.getByLibraryAndKey(lib,{J(a.item)});
const x=await Zotero.Attachments.importFromURL({{libraryID:lib,url:{J(pdf_url)},
  parentItemID:p.id,contentType:'application/pdf',title:p.getField('title')}});
return {{key:x.key,exists:await x.fileExists(),path:x.getFilePath()}};"""
    r = js(code, 240)
    if not isinstance(r, dict) or not r.get("exists"):
        die(f"downloaded but file missing: {r}")
    print(f"  attached {r['key']}: {r['path']}")


def api_get(url, timeout=30):
    try:
        p = subprocess.run(["curl", "-s", "-m", str(timeout), url],
                           capture_output=True, text=True, timeout=timeout + 10)
        return json.loads(p.stdout) if p.stdout.strip() else None
    except (ValueError, subprocess.SubprocessError):
        return None


def openalex_pdf(doi):
    d = api_get(f"https://api.openalex.org/works/https://doi.org/{doi}")
    if not d:
        return None, None
    loc = d.get("best_oa_location") or {}
    url = loc.get("pdf_url")
    if url:
        return url, "openalex"
    for loc in (d.get("locations") or []):
        if loc.get("pdf_url"):
            return loc["pdf_url"], "openalex"
    return None, None


def unpaywall_pdf(doi, email):
    if not email:
        print("  unpaywall: skipped (no --email)")
        return None, None
    d = api_get(f"https://api.unpaywall.org/v2/{doi}?email={email}")
    loc = (d or {}).get("best_oa_location") or {}
    url = loc.get("url_for_pdf")
    return (url, "unpaywall") if url else (None, None)


def arxiv_pdf(doi):
    m = re.search(r"10\.48550/arxiv\.(.+)", doi, re.I)
    if not m:
        return None, None
    arxiv_id = re.sub(r"v\d+$", "", m.group(1))
    return f"https://arxiv.org/pdf/{arxiv_id}.pdf", "arxiv"


def scihub_pdf(doi, mirrors):
    code = f"""
const DOI={J(doi)}, MIRRORS={J(mirrors)};
const UA='Mozilla/5.0 (iPhone; CPU iPhone OS 11_3_1 like Mac OS X) AppleWebKit/603.1.30 (KHTML, like Gecko) Version/10.0 Mobile/14E304 Safari/602.1';
for(const m of MIRRORS){{
  const u=m.replace(/\\/*$/,'/')+DOI;
  let xhr; try{{xhr=await Zotero.HTTP.request('GET',u,{{responseType:'document',headers:{{'User-Agent':UA}}}});}}
  catch(e){{continue;}}
  if(xhr.status!==200||!xhr.responseXML) continue;
  const el=xhr.responseXML.querySelector('#pdf');
  const src=el&&el.getAttribute('src');
  if(src){{const abs=new URL(src,u);abs.protocol='https:';return JSON.stringify({{url:abs.href,via:'scihub:'+m}});}}
}}
return JSON.stringify({{url:null}});"""
    r = js(code, 240)
    # js() double-decodes: success arrives as a dict, bridge timeout as {"_timeout": …}
    if isinstance(r, dict) and "_timeout" in r:
        print("  scihub: bridge timed out")
        return None, None
    d = r
    if isinstance(d, str):
        try:
            d = json.loads(d)
        except ValueError:
            return None, None
    if isinstance(d, dict) and d.get("url"):
        return d["url"], d.get("via", "scihub")
    return None, None


def cmd_repair(a):
    code = f"""
const lib={lib_js(a.library)};
if(Zotero.Libraries.get(lib).libraryType!=='group') throw new Error('repair is for group libraries only');
const s=new Zotero.Search();s.libraryID=lib;s.addCondition('itemType','is','attachment');
{"s.addCondition('dateAdded','isAfter'," + J(a.since) + ");" if a.since else ""}
const out=[];for(const it of await Zotero.Items.getAsync(await s.search())){{
  if(it.attachmentLinkMode>1) continue;
  if(!(await it.fileExists())) out.push({{key:it.key,expected:it.getFilePath(),
    parent:it.parentItem?it.parentItem.getField('citationKey'):''}});}}
return JSON.stringify(out);"""
    missing = js(code, 300)
    if isinstance(missing, dict):
        die("bridge timed out listing attachments; try --since YYYY-MM-DD")
    if not missing:
        print("no missing attachment files")
        return
    unresolved = 0
    for m in missing:
        if a.dry_run:
            print(f"missing {m['key']} [{m['parent']}]: {m['expected']}")
            continue
        got = restore_file(m["expected"])
        print(f"{m['key']} [{m['parent']}]: " + (f"restored {got}" if got else "NOT FOUND"))
        unresolved += 0 if got else 1
    sys.exit(3 if unresolved else 0)


def main():
    ap = argparse.ArgumentParser(prog="zotero-add", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--library", "-L", default=os.environ.get("ZOTERO_LIBRARY"),
                    help="'user', a group name (e.g. my-group), a groupID or a libraryID "
                         "(default: $ZOTERO_LIBRARY)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("item", help="create an item (dup-checked), optionally with files/snapshot")
    p.add_argument("type", help="Zotero item type: journalArticle, report, webpage, statute, letter, …")
    p.add_argument("--title", required=True)
    p.add_argument("--key", help="citation key to pin (Zotero 7 citationKey field)")
    p.add_argument("--person", action=Ordered, metavar="'Last, First[@role]'")
    p.add_argument("--org", action=Ordered, metavar="'Name[@role]'")
    p.add_argument("--date")
    p.add_argument("--url")
    p.add_argument("--field", action="append", default=[], metavar="name=value",
                   help="any other Zotero field, e.g. publicationTitle=…, DOI=…, institution=…")
    p.add_argument("--collection", action="append", metavar="COLLKEY")
    p.add_argument("--tag", action="append")
    p.add_argument("--no-default-tags", action="store_true", help=f"don't add {DEFAULT_TAGS}")
    p.add_argument("--file", action="append", help="attach a local file (PDF, HTML, …)")
    p.add_argument("--snapshot", action="store_true", help="save an HTML snapshot of --url via Zotero/SingleFile")
    p.add_argument("--force", action="store_true", help="skip the duplicate check")
    p.set_defaults(fn=cmd_item)

    p = sub.add_parser("attach", help="add a file and/or snapshot to an existing item, then verify")
    p.add_argument("item", help="Zotero item key (8 chars)")
    p.add_argument("--file", action="append")
    p.add_argument("--snapshot", action="store_true")
    p.add_argument("--url", help="snapshot this URL instead of the item's URL")
    p.set_defaults(fn=cmd_attach)

    p = sub.add_parser("dups", help="look for existing records (exit 1 if any)")
    p.add_argument("--title"); p.add_argument("--url"); p.add_argument("--doi"); p.add_argument("--key")
    p.set_defaults(fn=cmd_dups)

    p = sub.add_parser("check", help="list an item's attachments and whether their files exist")
    p.add_argument("item")
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser("audit", help="read-only health check: missing files + disk orphans (exit 1 if issues)")
    p.add_argument("--since", metavar="YYYY-MM-DD", help="only attachments added after this date")
    p.set_defaults(fn=cmd_audit)

    p = sub.add_parser("fetch-pdf", help="DOI -> PDF cascade (openalex, unpaywall, arxiv, scihub), then attach")
    p.add_argument("item", help="Zotero item key (8 chars)")
    p.add_argument("--doi", help="DOI (default: the item's DOI field)")
    p.add_argument("--sources", default="openalex,unpaywall,arxiv,scihub",
                   help="comma-separated subset in order (default: all)")
    p.add_argument("--mirrors", default="https://sci-hub.in/,https://sci-hub.ee/",
                   help="Sci-Hub mirrors, comma-separated")
    p.add_argument("--email", default=os.environ.get("UNPAYWALL_EMAIL", ""),
                   help="contact email for Unpaywall (or set $UNPAYWALL_EMAIL); "
                        "without one, the Unpaywall source is skipped")
    p.add_argument("--force", action="store_true", help="attach even if the item already has a PDF")
    p.set_defaults(fn=cmd_fetch_pdf)

    p = sub.add_parser("repair", help="move files Attanger displaced back into group storage")
    p.add_argument("--since", metavar="YYYY-MM-DD", help="only attachments added after this date")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_repair)

    a = ap.parse_args()
    if not a.library:
        die("say which library: --library my-group | user | <groupID> (or set ZOTERO_LIBRARY)")
    if a.cmd == "item":
        a.field_dict = {}
        for f in a.field:
            if "=" not in f:
                die(f"--field needs name=value: {f}")
            k, v = f.split("=", 1)
            a.field_dict[k] = v
    a.fn(a)


if __name__ == "__main__":
    main()
