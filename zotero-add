    p.add_argument(
        "--since", metavar="YYYY-MM-DD", help="only attachments added after this date"
    )
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_repair)

    a = ap.parse_args()
    if not a.library:
        die(
            "say which library: --library my-group | user | <groupID> (or set ZOTERO_LIBRARY)"
        )
    if a.cmd == "item":
        a.field_dict = {}
        for f in a.field:
            if "=" not in f:
                die(f"--field needs name=value: {f}")
            k, v = f.split("=", 1)
            a.field_dict[k] = v
    a.fn(a)


if __name__ == "__main__":
    main()
